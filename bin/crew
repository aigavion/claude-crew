#!/usr/bin/env bash
# crew — launch Claude Code as a named crew member.
#   crew Bob              join as "Bob" in the current repo
#   crew Bob --resume     extra args pass through to claude
# Set CREW_PLUGIN_DIR to a local checkout to load crew without installing it.
[ -z "$1" ] && { echo "usage: crew <name> [claude args...]"; exit 1; }
export CREW_NAME="$1"; shift
if [ -n "$CREW_PLUGIN_DIR" ]; then
  exec claude --plugin-dir "$CREW_PLUGIN_DIR" "$@"
else
  exec claude "$@"
fi
